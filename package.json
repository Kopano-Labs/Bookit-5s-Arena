{
  "name": "bookit-5s-arena",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build --no-lint",
    "start": "next start",
    "lint": "eslint",
    "build:css": "npx tailwindcss -i ./assets/styles/globals.css -o ./public/styles.css --minify",
    "diagnose:atlas": "node --env-file=.env.local scripts/diagnose-atlas-access.mjs",
    "validate:offline-sync": "node --env-file=.env.local scripts/validate-offline-sync-contract.mjs",
    "validate:offline-sync:shape": "node --env-file=.env.local scripts/validate-offline-sync-shape.mjs",
    "validate:court-assets": "node scripts/validate-court-assets.mjs",
    "fixtures:health-check": "node scripts/fixtures-health-check.mjs",
    "validate:fixtures-vault": "node scripts/validate-fixtures-vault-shape.mjs",
    "test": "jest",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "audit:fix:force": "npm audit fix --force"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/sandbox": "^1.9.3",
    "bcryptjs": "^3.0.5",
    "botid": "^1.5.11",
    "dotenv": "^17.3.1",
    "eslint-plugin-react": "^7.37.5",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "mongodb": "^7.1.1",
    "mongoose": "^9.3.3",
    "next": "^15.5.18",
    "next-auth": "^4.24.13",
    "nodemailer": "^8.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-google-recaptcha": "^3.1.0",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0",
    "resend": "^6.9.4",
    "stripe": "^20.4.1",
    "three": "^0.184.0"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "^8.0.4"
    }
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29.5.11",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.4.0",
    "eslint-config-next": "^15.5.18",
    "jest": "^29.7.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.4.5"
  }
}